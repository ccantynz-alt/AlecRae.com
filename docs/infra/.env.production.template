# ============================================================
# AlecRae - Production Environment Template
# ============================================================
# Never commit real values. Copy to .env.production, fill in,
# then push to Vercel/Fly/Cloudflare via their secret
# management. See env-audit.md in this directory for details
# on every variable, including where to obtain each value.
#
# Legend:
#   <angle_brackets>  = Craig-filled value
#   # OPTIONAL        = app runs without it (feature disabled)
#   # REQUIRED        = boot fails without it
# ============================================================


# ------------------------------------------------------------
# Core Runtime
# ------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=3000


# ------------------------------------------------------------
# Database - Neon Postgres
# ------------------------------------------------------------
# REQUIRED
DATABASE_URL=<neon_pooled_connection_string>
DIRECT_URL=<neon_direct_connection_string>


# ------------------------------------------------------------
# Cache / Queue - Redis
# ------------------------------------------------------------
# REQUIRED. This is the outbound mail queue as well as the store for rate
# limits, quotas, login lockouts and warm-up counters.
#
# ⚠ THE API BOX AND THE MAIL BOX MUST USE THE BYTE-IDENTICAL VALUE.
# The API (Jarvis) enqueues sends; the MTA (mail box) consumes them. Point
# them at different Redis instances - including by leaving one on the
# localhost default - and every send SILENTLY DISAPPEARS: the API enqueues,
# returns success, and the MTA watches a queue that never fills. No bounce,
# no error, no log line.
#
# Setup runbook (bind address, requirepass, firewall, and the check that
# proves both boxes see the SAME queue): docs/infra/redis-tailnet-setup.md
REDIS_URL=redis://:<password>@<jarvis-tailnet-ip>:6379

# NOTE: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN used to be listed
# here as REQUIRED. No code has ever read them - the runtime reads REDIS_URL
# (falling back to UPSTASH_REDIS_URL, a plain redis:// URL, not the REST
# pair). They were removed rather than left to imply a working integration.


# ------------------------------------------------------------
# Auth - JWT + Sessions
# ------------------------------------------------------------
# REQUIRED - generate with: openssl rand -base64 64
JWT_SECRET=<random_64_byte_base64>
SESSION_SECRET=<random_64_byte_base64>

# RSA keypair for asymmetric JWT signing (multi-line PEM)
JWT_PUBLIC_KEY=<pem_public_key>
JWT_PRIVATE_KEY=<pem_private_key>

# OPTIONAL - defaults shown
JWT_ISSUER=alecrae
JWT_AUDIENCE=alecrae-collab


# ------------------------------------------------------------
# Auth - WebAuthn / Passkeys
# ------------------------------------------------------------
WEBAUTHN_RP_ID=alecrae.com
WEBAUTHN_RP_NAME=AlecRae
WEBAUTHN_ORIGIN=https://mail.alecrae.com


# ------------------------------------------------------------
# App URLs (public - safe to ship to browser)
# ------------------------------------------------------------
# REQUIRED (server-side). The API refuses to boot in production without it.
# Distinct from NEXT_PUBLIC_API_URL below: this is the value the API itself
# embeds in OUTBOUND EMAIL - the List-Unsubscribe header and click-tracking
# links. If it is unset the code falls back to http://localhost:3001, which
# means every recipient gets a dead one-click unsubscribe (a Gmail/Yahoo bulk
# sender requirement) and every tracked link in the message points at
# localhost. Must be https and must not be localhost.
API_URL=https://api.alecrae.com

NEXT_PUBLIC_APP_URL=https://mail.alecrae.com
NEXT_PUBLIC_API_URL=https://api.alecrae.com
NEXT_PUBLIC_WS_URL=wss://api.alecrae.com
NEXT_PUBLIC_MARKETING_URL=https://alecrae.com


# ------------------------------------------------------------
# AI - Anthropic Claude
# ------------------------------------------------------------
# REQUIRED for AI features (core product)
ANTHROPIC_API_KEY=<sk-ant-api03-xxxxx>


# ------------------------------------------------------------
# AI - OpenAI (Whisper transcription only)
# ------------------------------------------------------------
OPENAI_API_KEY=<sk-proj-xxxxx>


# ------------------------------------------------------------
# AI - Voyage (embeddings, semantic search)
# ------------------------------------------------------------
# OPTIONAL - disables semantic search if absent
VOYAGE_API_KEY=<pa-xxxxx>


# ------------------------------------------------------------
# Payments - Stripe
# ------------------------------------------------------------
STRIPE_SECRET_KEY=<sk_live_xxxxx>
STRIPE_WEBHOOK_SECRET=<whsec_xxxxx>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_xxxxx>


# ------------------------------------------------------------
# OAuth - Google (Gmail sync + SSO)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=<xxxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-xxxxx>


# ------------------------------------------------------------
# OAuth - Microsoft (Outlook / Graph API)
# ------------------------------------------------------------
MICROSOFT_CLIENT_ID=<azure_app_client_id>
MICROSOFT_CLIENT_SECRET=<azure_app_client_secret>
MICROSOFT_TENANT_ID=common


# ------------------------------------------------------------
# MTA - Outbound SMTP + DKIM signing
# ------------------------------------------------------------
MTA_HOSTNAME=smtp.alecrae.com

# NOTE: DKIM_SELECTOR / DKIM_PRIVATE_KEY env vars were removed from this
# template — NO code reads them. DKIM keys are stored per-domain (encrypted)
# in the `domains` table and read by services/mta/src/worker.ts. An operator
# who sets only the env vars gets every message held for "no DKIM key"
# with a correct-looking config.

POSTMASTER_EMAIL=postmaster@alecrae.com
ABUSE_EMAIL=abuse@alecrae.com
DMARC_EMAIL=dmarc@alecrae.com


# ------------------------------------------------------------
# MTA - IP warmup pacing (deliverability)
# ------------------------------------------------------------
# Enforces the week-by-week ramp in docs/infra/deliverability.md. Opening the
# firehose from a cold IP is the fastest way to get blocklisted, so the gate
# is ON unless explicitly disabled. Over-cap recipients are DEFERRED (retried
# after the UTC-midnight reset), never dropped.
#
# The date sending began from this IP. Determines which week of the ramp we
# are in. If unset, today counts as day 1 - the most restrictive reading.
MTA_WARMUP_STARTED_AT=2026-07-29

# Public IP that carries the sending reputation. Only namespaces the counters;
# falls back to MTA_HOSTNAME when unset.
MTA_PUBLIC_IP=149.28.119.158

# Set to "false" ONLY for an IP with established reputation. Any other value
# (or unset) leaves enforcement on.
# NOT the way to get day-one volume - that opens the firehose from the cold
# IP (blocklist risk). Use MTA_RELAY_MODE=overflow below instead.
MTA_WARMUP_ENABLED=true


# ------------------------------------------------------------
# MTA - Relay + relay mode (day-one volume while the IP warms)
# ------------------------------------------------------------
# "all" (default when RELAY_PROVIDER is set and this is unset): everything
#   relays; the warm-up gate is NOT consulted - relayed reputation accrues to
#   the relay's warm IPs, not ours, so gating it would throttle needlessly
#   and pollute our warm-up counters.
# "overflow": direct MX within the warm-up caps (consuming quota as usual);
#   cap-refused recipients relay in the same job instead of deferring to the
#   next UTC day. Full volume from day one, the IP warms at exactly the safe
#   rate, and the relay share shrinks to zero automatically as caps double
#   weekly - cutover needs no operator action.
# Any other value is treated as "all" with a loud warning (only exact
# expected values change behaviour - the MTA_REQUIRE_DKIM pattern).
# Irrelevant when RELAY_PROVIDER is unset (everything goes direct MX).
MTA_RELAY_MODE=overflow

# Resend SMTP relay (the documented Resend SMTP interface).
RELAY_PROVIDER=smtp
SMTP_RELAY_HOST=smtp.resend.com          # Resend SMTP endpoint
SMTP_RELAY_PORT=587                      # STARTTLS submission port
SMTP_RELAY_USERNAME=resend               # literally the string "resend"
SMTP_RELAY_PASSWORD=<resend_api_key>     # the Resend API key
SMTP_RELAY_TLS=true                      # STARTTLS on 587 (465 = implicit TLS)

# --- Vapron REST relay (RELAY_PROVIDER=vapron) --------------------------
# The intended production path. AlecRae has no unblocked port 25, so it does
# NOT deliver to the internet itself — it relays outbound through Vapron's
# send API (POST ${VAPRON_EMAIL_SEND_URL}/v1/messages, bearer auth). Vapron
# re-composes and DKIM-signs the message via its email-domain service and owns
# delivery + retry. The sender's FROM domain must be registered/verified in
# Vapron's email-domain, or the send returns 403 (a permanent bounce for that
# message). Set RELAY_PROVIDER=vapron above to select this provider.
# Full architecture: docs/infra/alecrae-vapron-mail-integration.md.
# RELAY_PROVIDER=vapron
VAPRON_EMAIL_SEND_URL=http://100.89.227.39:8787   # Vapron send base URL (tailnet)
VAPRON_EMAIL_SEND_TOKEN=<vapron_email_send_token> # Bearer token (never commit the real value)


# ------------------------------------------------------------
# MTA - DKIM enforcement
# ------------------------------------------------------------
# Refuse to send a message we could not DKIM-sign. Gmail and Yahoo require
# DKIM from bulk senders, and alecrae.com publishes DMARC p=quarantine - an
# unsigned message then has only SPF to fall back on, and SPF breaks on any
# forwarded path (mailing lists, .forward rules) where DKIM would survive.
# Unsigned mail costs the reputation of every domain sharing the IP.
#
# Unsigned messages are HELD (deferred), not bounced - they send as soon as a
# key is configured. Only "false" disables the check; anything else leaves it
# on, so a typo fails safe.
MTA_REQUIRE_DKIM=true


# ------------------------------------------------------------
# Search - Meilisearch
# ------------------------------------------------------------
MEILI_HOST=<https://search.alecrae.com>
MEILI_MASTER_KEY=<meili_master_key>


# ------------------------------------------------------------
# Storage - Cloudflare R2
# ------------------------------------------------------------
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET=alecrae-attachments
R2_ENDPOINT=<https://account-id.r2.cloudflarestorage.com>


# ------------------------------------------------------------
# Observability - OpenTelemetry
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=<otlp_collector_url>
OTEL_SERVICE_NAME=alecrae-api


# ------------------------------------------------------------
# Observability - Sentry
# ------------------------------------------------------------
# OPTIONAL - disables error reporting if absent
SENTRY_DSN=<https://key@sentry.io/project>


# ------------------------------------------------------------
# Collab (Yjs real-time drafting) - S2 feature
# ------------------------------------------------------------
# OPTIONAL - defaults shown in env-audit.md
COLLAB_WS_URL=wss://collab.alecrae.com
COLLAB_HTTP_URL=https://collab.alecrae.com
COLLAB_JWT_SECRET=<random_64_byte_base64_or_reuse_JWT_SECRET>


# ------------------------------------------------------------
# Enterprise - SAML SSO (Team/Enterprise plans only)
# ------------------------------------------------------------
# OPTIONAL - disables SAML login if absent
SAML_ENTITY_ID=https://admin.alecrae.com/saml/metadata
SAML_ACS_URL=https://admin.alecrae.com/saml/acs

# Multi-line PEM
SAML_CERT=<pem_x509_cert>
SAML_PRIVATE_KEY=<pem_private_key>
