    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@alecrae/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
