{
  "name": "@alecrae/sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered zero-latency validation pipeline — the immune system of AlecRae",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
