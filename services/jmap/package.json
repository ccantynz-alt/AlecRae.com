{
  "name": "@alecrae/jmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "echo 'Service runs from source under Bun — no build step; see start'",
